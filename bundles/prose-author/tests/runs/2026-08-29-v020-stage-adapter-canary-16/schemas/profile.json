      "required": [
        "qualification-hedging",
        "opponents-allies-sources",
        "figures-analogy",
        "openings-endings-closure",
        "profanity-vulgarity"
      ]
    },
    "gaps": {
      "type": "string",
      "minLength": 40,
      "maxLength": 900
    },
    "observations_dropped": {
      "type": "integer",
      "minimum": 0
    },
    "multiple_voices_suspected": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "voice_card",
    "measured",
    "qualitative",
    "unresolved",
    "gaps",
    "observations_dropped",
    "multiple_voices_suspected"
