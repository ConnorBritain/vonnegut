    "measured": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "second-person-family": {
          "$ref": "#/$defs/measuredSemantic"
        },
        "first-person-plural-family": {
          "$ref": "#/$defs/measuredSemantic"
        },
        "contractions": {
          "$ref": "#/$defs/measuredSemantic"
        },
        "uncontracted-negatives": {
          "$ref": "#/$defs/measuredSemantic"
        },
        "first-person-singular-family": {
          "$ref": "#/$defs/measuredSemantic"
        },
        "question-marks": {
          "$ref": "#/$defs/measuredSemantic"
        },
        "round-parenthetical-spans": {
          "$ref": "#/$defs/measuredSemantic"
        },
        "em-dashes": {
          "$ref": "#/$defs/measuredSemantic"
        },
        "en-dashes": {
          "$ref": "#/$defs/measuredSemantic"
        }
      },
      "required": [
        "second-person-family",
        "first-person-plural-family",
        "contractions",
        "uncontracted-negatives",
        "first-person-singular-family",
        "question-marks",
        "round-parenthetical-spans",
        "em-dashes",
        "en-dashes"
      ]
    },
    "qualitative": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/qualitativeObservation"
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qualification-hedging": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 20,
          "maxLength": 500
        },
        "opponents-allies-sources": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 20,
          "maxLength": 500
        },
        "figures-analogy": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 20,
          "maxLength": 500
        },
        "openings-endings-closure": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 20,
          "maxLength": 500
        },
        "profanity-vulgarity": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        }
