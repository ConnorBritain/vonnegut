{
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "measuredSemantic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prose": {
          "type": "string",
          "minLength": 100,
          "maxLength": 450
        }
      },
      "required": [
        "prose"
      ]
    },
    "qualitativeObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "qualification-hedging",
              "opponents-allies-sources",
              "figures-analogy",
              "openings-endings-closure"
            ]
          }
        },
        "section": {
          "type": "string",
          "enum": [
            "cadence",
            "openings",
            "closings",
            "address",
            "figures",
            "register-range",
            "absences"
          ]
        },
        "prose": {
          "type": "string",
          "minLength": 100,
          "maxLength": 450
        },
        "support_files": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "dimensions",
        "section",
        "prose",
        "support_files"
      ]
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "const": "voice-profile-source/4"
    },
    "voice_card": {
      "type": "string",
      "enum": [
        "empty",
        "corroborating",
        "contradicted"
